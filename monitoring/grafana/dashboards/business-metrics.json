{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Orders Created (rate/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(ftgo_orders_created_total[5m]) * 60",
          "legendFormat": "orders/min"
        }
      ]
    },
    {
      "title": "Orders Accepted (rate/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(ftgo_orders_accepted_total[5m]) * 60",
          "legendFormat": "accepted/min"
        }
      ]
    },
    {
      "title": "Orders Failed vs Cancelled",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(ftgo_orders_failed_total[5m]) * 60",
          "legendFormat": "failed/min"
        },
        {
          "expr": "rate(ftgo_orders_cancelled_total[5m]) * 60",
          "legendFormat": "cancelled/min"
        }
      ]
    },
    {
      "title": "Order Processing Time (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ftgo_orders_processing_time_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(ftgo_orders_processing_time_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Order Failure Rate (%)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(ftgo_orders_failed_total[5m]) / rate(ftgo_orders_created_total[5m]) * 100",
          "legendFormat": "failure %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 10 }] }
        }
      }
    },
    {
      "title": "Consumers Registered (rate/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(ftgo_consumers_registered_total[5m]) * 60",
          "legendFormat": "registrations/min"
        }
      ]
    },
    {
      "title": "Restaurants Created (rate/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(ftgo_restaurants_created_total[5m]) * 60",
          "legendFormat": "restaurants/min"
        }
      ]
    },
    {
      "title": "Deliveries Completed (rate/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(ftgo_deliveries_completed_total[5m]) * 60",
          "legendFormat": "deliveries/min"
        }
      ]
    },
    {
      "title": "Consumer Validation Failures",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(ftgo_consumers_validation_failures_total[5m]) * 60",
          "legendFormat": "failures/min"
        }
      ]
    },
    {
      "title": "Menu Revisions (rate/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(ftgo_restaurants_menu_revisions_total[5m]) * 60",
          "legendFormat": "revisions/min"
        }
      ]
    },
    {
      "title": "Courier Availability",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(ftgo_couriers_available_total[5m]) * 60",
          "legendFormat": "available/min"
        },
        {
          "expr": "rate(ftgo_couriers_unavailable_total[5m]) * 60",
          "legendFormat": "unavailable/min"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["ftgo", "business-metrics"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "FTGO Business Metrics",
  "uid": "ftgo-business-metrics"
}
